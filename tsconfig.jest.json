{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "jsx": "react",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "lib": ["es5", "scripthost", "es2015", "es2015.collection", "es2015.promise", "es2015.iterable", "dom", "es2016.array.include", "es2017.string", "es2017.object"],
    "types": ["webpack-env", "jest"],
    "typeRoots": ["./node_modules/@types", "./node_modules/@microsoft"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
